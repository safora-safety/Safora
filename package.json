{
  "name": "safora",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm test --workspace=apps/backend && npm test --workspace=@safora/frontend && npm test --workspace=mobile",
    "test:backend": "npm test --workspace=apps/backend",
    "test:frontend": "npm test --workspace=@safora/frontend",
    "test:mobile": "npm test --workspace=mobile",
    "prepare": "npx husky"
  },
  "lint-staged": {
    "apps/backend/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/mobile/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
