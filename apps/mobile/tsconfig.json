{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@safora/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
